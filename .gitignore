__pycache__/
*.pyc

# work-order card and receipt-gate receipt: per task, per machine, never
# versioned (see work-order/ADOPTION.md and receipt-gate/adapt/README.md)
CARD.yaml
CARD.close
CARD.receipt.json
*.receipt.json

# .claude/ is session-local (worktrees, local settings, skill pointers) except the
